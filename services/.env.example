# Copy outside the repository, for example ~/.config/dev-services/local.env.
# Set all three SQL passwords before validating the main Compose file.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
POSTGRES_PASSWORD=
MYSQL_DATABASE=dev
MYSQL_USER=dev
POSTGRES_DB=dev
POSTGRES_USER=dev
MYSQL_PORT=3306
POSTGRES_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# Required only for the separate Redis/Meilisearch Compose files.
# Fill after checking the projects' requirements and ARM64 image availability.
REDIS_IMAGE=
REDIS_PORT=6379
MEILISEARCH_IMAGE=
MEILI_MASTER_KEY=
MEILISEARCH_PORT=7700
