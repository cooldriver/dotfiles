# Copy outside the repository, for example ~/.config/dev-services/local.env.
# MySQL and PostgreSQL run in DBngin, outside Compose. Keep SQL passwords outside this file.
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# Required only for the separate Redis/Meilisearch Compose files.
# Fill after checking the projects' requirements and ARM64 image availability.
REDIS_IMAGE=
REDIS_PORT=6379
MEILISEARCH_IMAGE=
MEILI_MASTER_KEY=
MEILISEARCH_PORT=7700
