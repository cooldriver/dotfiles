# Copy outside the repository, for example ~/.config/dev-services/local.env.
# MySQL and PostgreSQL run in DBngin, outside Compose. Keep SQL passwords outside this file.
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
# On Toola, set to unless-stopped in the private local.env after reviewing the services.
# Leave at no on Tatooine to avoid starting containers not needed for the current project.
DEV_SERVICES_RESTART=no

# Required only for the separate Redis/Meilisearch Compose files.
# Stable ARM64 images checked 2026-09-30; check project compatibility before using existing data.
REDIS_IMAGE=redis:8.10.2
REDIS_PORT=6379
MEILISEARCH_IMAGE=getmeili/meilisearch:v1.54.2
# Generate locally (openssl rand -hex 32); never commit the actual key.
MEILI_MASTER_KEY=
MEILISEARCH_PORT=7700
