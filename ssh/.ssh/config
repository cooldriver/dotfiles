# macOS workstation only. Keep OrbStack's generated include first.
Include ~/.orbstack/ssh/config

# Reset the Host context left by the generated include.
Host *
    Include ~/.ssh/config.private

# Stable aliases; private rules select the locally exported public keys.
Host personalgit
    HostName github.com
    User git

Host workgit
    HostName github.com
    User git

Host *
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
    IdentitiesOnly yes
