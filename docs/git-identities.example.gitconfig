# Copy the relevant section to a local file outside this repository:
# ~/.config/git/personal.gitconfig or ~/.config/git/work.gitconfig
#
# These local files are required before using Git in the matching directories.
# Do not add a private email address or a signing key to this repository.

[user]
    name = Your Name
    email = you@example.com
    signingkey = ssh-ed25519 REPLACE_WITH_ACCOUNT_PUBLIC_KEY

# macOS only, with 1Password installed in /Applications by the Brewfile.
# Omit this section on hosts without the 1Password application.
[gpg "ssh"]
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
