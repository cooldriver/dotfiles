# macOS: enable the 1Password SSH agent, export only the public keys below.
# Merge these entries into ~/.ssh/config before any general Host * rules.

Host github-personal
    HostName github.com
    User git
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
    IdentityFile ~/.ssh/github-personal.pub
    IdentitiesOnly yes
    HostKeyAlias github.com

Host github-work
    HostName github.com
    User git
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
    IdentityFile ~/.ssh/github-work.pub
    IdentitiesOnly yes
    HostKeyAlias github.com
